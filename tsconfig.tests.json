{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "noEmit": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo/tests.tsbuildinfo"
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.mts",
    "vitest.config.mts",
    "playwright.config.ts"
  ]
}
